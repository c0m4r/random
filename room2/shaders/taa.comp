#version 450
// room2 - temporal antialiasing resolve. Reprojects the previous frame's resolved
// colour through the depth buffer, clips the history to the current neighbourhood to
// suppress ghosting, and blends. Camera-only motion vectors are sufficient here
// because the only fast-moving geometry is the glass shards, which are small.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0) uniform sampler2D uCurrent;
layout(set = 2, binding = 1) uniform sampler2D uDepth;
layout(set = 2, binding = 2) uniform sampler2D uHistory;
layout(set = 2, binding = 3, rgba16f) uniform image2D uOut;
layout(set = 2, binding = 4) uniform sampler2D uEmissive;   // alpha = linear view depth

// Variance clipping (Karis): clips the history colour into the local colour
// distribution of the current frame.
vec3 clipToNeighbourhood(vec3 history, vec3 centre, vec3 moment1, vec3 moment2) {
    vec3 mu = moment1;
    vec3 sigma = sqrt(max(moment2 - moment1 * moment1, vec3(0.0)));
    vec3 minC = mu - 1.25 * sigma;
    vec3 maxC = mu + 1.25 * sigma;
    // Also intersect with the min/max box to bound the clipping.
    return clamp(history, minC, maxC);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uOut);
    if (px.x >= size.x || px.y >= size.y) return;

    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    vec2 texel = 1.0 / vec2(size);

    vec3 current = texture(uCurrent, uv).rgb;
    float depth = texture(uDepth, uv).r;

    float blend = clamp(g.postParams.z, 0.0, 1.0);
    if (blend <= 0.0 || depth >= 1.0) {
        imageStore(uOut, px, vec4(current, 1.0));
        return;
    }

    // Reproject through the previous frame's view-projection.
    vec3 world = r2_worldFromDepth(uv, texture(uEmissive, uv).a);
    vec4 prevClip = g.prevViewProjection * vec4(world, 1.0);
    vec2 prevUv = (prevClip.xy / max(prevClip.w, 1e-6)) * 0.5 + 0.5;

    if (prevUv.x < 0.0 || prevUv.x > 1.0 || prevUv.y < 0.0 || prevUv.y > 1.0 ||
        prevClip.w <= 0.0) {
        imageStore(uOut, px, vec4(current, 1.0));
        return;
    }

    // Neighbourhood statistics from a 3x3 tap.
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec3 mn = vec3(1e9);
    vec3 mx = vec3(-1e9);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec3 c = texture(uCurrent, uv + vec2(x, y) * texel).rgb;
            m1 += c;
            m2 += c * c;
            mn = min(mn, c);
            mx = max(mx, c);
        }
    }
    m1 /= 9.0;
    m2 /= 9.0;

    vec3 history = texture(uHistory, prevUv).rgb;
    vec3 clipped = clipToNeighbourhood(history, current, m1, m2);
    clipped = clamp(clipped, mn, mx);

    // Reject history that is wildly different (disocclusion) by shortening the blend.
    float diff = length(clipped - history) / max(length(history) + 1e-4, 1e-4);
    float adaptiveBlend = mix(blend, 1.0, clamp(diff * 4.0, 0.0, 1.0));

    vec3 result = mix(clipped, current, adaptiveBlend);
    imageStore(uOut, px, vec4(max(result, vec3(0.0)), 1.0));
}
