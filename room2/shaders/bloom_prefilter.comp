#version 450
// room2 - bloom prefilter: soft-knee bright pass with a 2x downsample.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0) uniform sampler2D uHdrColor;
layout(set = 2, binding = 1, rgba16f) uniform image2D uOutBloom;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uOutBloom);
    if (px.x >= size.x || px.y >= size.y) return;

    vec2 srcSize = vec2(textureSize(uHdrColor, 0));
    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    vec2 texel = 1.0 / srcSize;

    // 4-tap box downsample to reduce fireflies.
    vec3 c = texture(uHdrColor, uv + texel * vec2(-0.5, -0.5)).rgb;
    c += texture(uHdrColor, uv + texel * vec2( 0.5, -0.5)).rgb;
    c += texture(uHdrColor, uv + texel * vec2(-0.5,  0.5)).rgb;
    c += texture(uHdrColor, uv + texel * vec2( 0.5,  0.5)).rgb;
    c *= 0.25;

    float brightness = r2_luma(c);
    float threshold = 1.05;
    float knee = 0.6;
    float soft = clamp(brightness - threshold + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee + 1e-5);
    float contribution = max(soft, brightness - threshold) / max(brightness, 1e-5);

    imageStore(uOutBloom, px, vec4(c * contribution, 1.0));
}
