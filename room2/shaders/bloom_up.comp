#version 450
// room2 - bloom upsample (3x3 tent filter, additively accumulated into the larger mip).
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0) uniform sampler2D uSource;   // smaller mip
layout(set = 2, binding = 1) uniform sampler2D uTarget;   // larger mip (read + add)
layout(set = 2, binding = 2, rgba16f) uniform image2D uDest;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uDest);
    if (px.x >= size.x || px.y >= size.y) return;

    vec2 srcSize = vec2(textureSize(uSource, 0));
    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    vec2 t = 1.0 / srcSize;

    vec3 sum = texture(uSource, uv + t * vec2(-1.0,  1.0)).rgb * 1.0;
    sum += texture(uSource, uv + t * vec2( 0.0,  1.0)).rgb * 2.0;
    sum += texture(uSource, uv + t * vec2( 1.0,  1.0)).rgb * 1.0;
    sum += texture(uSource, uv + t * vec2(-1.0,  0.0)).rgb * 2.0;
    sum += texture(uSource, uv).rgb * 4.0;
    sum += texture(uSource, uv + t * vec2( 1.0,  0.0)).rgb * 2.0;
    sum += texture(uSource, uv + t * vec2(-1.0, -1.0)).rgb * 1.0;
    sum += texture(uSource, uv + t * vec2( 0.0, -1.0)).rgb * 2.0;
    sum += texture(uSource, uv + t * vec2( 1.0, -1.0)).rgb * 1.0;
    sum *= (1.0 / 16.0);

    vec3 base = texture(uTarget, uv).rgb;
    imageStore(uDest, px, vec4(base + sum, 1.0));
}
